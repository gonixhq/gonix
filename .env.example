# ════════════════════════════════════════════════════════════
# Gonix Clinic OS — ตัวอย่างไฟล์ environment variables
# ────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)
# ทุก key ด้านล่างมีโค้ดที่อ่านใช้จริง (จาก process.env.*)
# ════════════════════════════════════════════════════════════

# ── Supabase (ฐานข้อมูล + Auth) ──────────────────────────────
# จาก Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            # anon/public key (ฝั่ง client, ผ่าน RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                # service role (bypass RLS) — ใช้เฉพาะ cron/server เท่านั้น ห้ามหลุดฝั่ง client

# ── LINE Messaging API (แจ้งเตือน/ตอบกลับ OA) ────────────────
# จาก LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxx                     # ส่ง push/reply (lib/line.ts)
LINE_CHANNEL_SECRET=xxxxxxxx                           # ตรวจลายเซ็น webhook (x-line-signature)

# ── LINE Login (verify ID token ตอนผูกบัญชี/รายงานอาการ) ─────
LINE_LOGIN_CHANNEL_ID=1234567890                       # channel id ของ LINE Login (follow-up.ts)

# ── LIFF (หน้าเว็บใน LINE) ───────────────────────────────────
# จาก LINE Developers Console → LIFF
NEXT_PUBLIC_LIFF_ID_LINK=1234567890-xxxxxxxx           # หน้า /line/link (ผูก HN กับ LINE)
NEXT_PUBLIC_LIFF_ID_REPORT=1234567890-xxxxxxxx         # หน้า /line/report (รายงานอาการหลังรักษา)

# ── คลินิก (multi-tenant) ────────────────────────────────────
NEXT_PUBLIC_CLINIC_ID=11111111-1111-1111-1111-111111111111  # tenants.id ของคลินิกนี้ (ใช้ในหน้า LIFF)

# ── Cron (งานอัตโนมัติ — Vercel Cron / ยิงเอง) ───────────────
CRON_SECRET=ตั้งค่าสุ่มยาว ๆ                            # ต้องส่งมาใน Authorization: Bearer <นี้> ทุก endpoint ใต้ /api/cron/*
